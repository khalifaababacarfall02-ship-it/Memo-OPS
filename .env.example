# Copy to .env.local for local development. On Vercel, set the same variables
# in Project Settings → Environment Variables (Production + Preview).

# --- Supabase (public: safe in the browser, data is protected by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…). The legacy anon key also works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ…
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Sign-in ---
# Who may sign in is in the database: admins invite people on /team.
# Public URL of the app, used in magic-link redirects. Optional on Vercel
# (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Asana (phase 2, server-only; leave empty to hide "Send to Asana") ---
ASANA_ACCESS_TOKEN=
# The "Memos" project that receives the tasks (numeric gid).
ASANA_PROJECT_GID=
# Tests only (local Asana mock): https, or http to localhost. Default: https://app.asana.com/api/1.0
# ASANA_API_BASE=

# --- Slack (server-only; without it "Send on Slack" says Slack is not connected) ---
# Bot token of the "Mémo BoxHero" app (slack/manifest.json): xoxb-…
SLACK_BOT_TOKEN=
# Tests only (local Slack mock): https, or http to localhost. Default: https://slack.com/api
# SLACK_API_BASE=
# Tests only: extra calendar hosts the server may fetch (e.g. localhost:4995 for a mock).
# CALENDAR_TEST_HOSTS=
